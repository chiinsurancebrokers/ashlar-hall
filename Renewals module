def _portal_url():
    return st.secrets.get("PORTAL_API_URL", "").rstrip("/")

def _portal_key():
    return st.secrets.get("PORTAL_API_KEY", "")

def _api_get(path, params=None):
    """Call CHI Portal REST API. Returns (data, error_str)."""
    base = _portal_url()
    key  = _portal_key()
    if not base:
        return None, "PORTAL_API_URL not set in Streamlit secrets."
    if not key:
        return None, "PORTAL_API_KEY not set in Streamlit secrets."
    try:
        r = requests.get(
            f"{base}{path}",
            headers={"X-API-Key": key},
            params=params,
            timeout=15,
        )
        if r.status_code == 401:
            return None, "API key rejected — check PORTAL_API_KEY in secrets."
        if r.status_code != 200:
            return None, f"Portal returned HTTP {r.status_code}: {r.text[:200]}"
        return r.json(), None
    except requests.exceptions.ConnectionError:
        return None, f"Cannot reach portal at {base} — is it running on Railway?"
    except Exception as e:
        return None, f"Request error: {e}"


def _days_badge(days):
    if days <= 2:
        return f'<span style="background:#dc2626;color:white;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:700;">🔴 {days}d</span>'
    elif days <= 7:
        return f'<span style="background:#d97706;color:white;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:700;">🟠 {days}d</span>'
    elif days <= 14:
        return f'<span style="background:#ca8a04;color:white;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:700;">🟡 {days}d</span>'
    else:
        return f'<span style="background:#16a34a;color:white;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:700;">🟢 {days}d</span>'


def _send_gmail(to_email, subject, body_html):
    """Send email via Gmail SMTP. Returns (ok, msg)."""
    sender   = st.secrets.get("GMAIL_SENDER", "")
    password = st.secrets.get("GMAIL_APP_PASSWORD", "").replace(" ", "")
    if not sender or not password:
        return False, "GMAIL_SENDER / GMAIL_APP_PASSWORD not set in secrets."
    try:
        msg = MIMEMultipart("alternative")
        msg["Subject"] = subject
        msg["From"]    = sender
        msg["To"]      = to_email
        msg.attach(MIMEText(body_html, "html", "utf-8"))
        with smtplib.SMTP_SSL("smtp.gmail.com", 465) as server:
            server.login(sender, password)
            server.sendmail(sender, to_email, msg.as_string())
        return True, "Sent"
    except Exception as e:
        return False, str(e)


def _send_whatsapp(to_phone, message_body):
    """Send WhatsApp via Twilio. Returns (ok, msg)."""
    sid   = st.secrets.get("TWILIO_SID", "")
    token = st.secrets.get("TWILIO_AUTH_TOKEN", "")
    from_ = st.secrets.get("TWILIO_FROM", "whatsapp:+14155238886")
    if not sid or not token:
        return False, "TWILIO_SID / TWILIO_AUTH_TOKEN not set in secrets."

    # Normalise phone number
    phone = re.sub(r"[^\d+]", "", to_phone)
    if not phone.startswith("+"):
        phone = "+30" + phone.lstrip("0")  # default Greek country code
    to_ = f"whatsapp:{phone}"

    try:
        r = requests.post(
            f"https://api.twilio.com/2010-04-01/Accounts/{sid}/Messages.json",
            auth=(sid, token),
            data={"From": from_, "To": to_, "Body": message_body},
            timeout=15,
        )
        if r.status_code in (200, 201):
            return True, "Sent"
        return False, f"Twilio error {r.status_code}: {r.json().get('message', r.text[:200])}"
    except Exception as e:
        return False, str(e)


