            if not targets:
                st.warning("Δεν υπάρχουν επείγοντα με email.")
            else:
                ok_count, fail_count = 0, 0
                prog = st.progress(0)
                for i, p in enumerate(targets):
                    pid = str(p.get("id", i))
                    subj, body = _build_email_html(p, agent_default)
                    ok, _ = _send_gmail(p["client_email"], subj, body)
                    if ok:
                        st.session_state.renewal_sent.setdefault(pid, {})["email"] = True
                        ok_count += 1
                    else:
                        fail_count += 1
                    prog.progress((i + 1) / len(targets))
                st.success(f"✅ {ok_count} emails εστάλησαν · ❌ {fail_count} αποτυχίες")
                st.rerun()

    with bc2:
