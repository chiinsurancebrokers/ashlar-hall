TWILIO_SID       = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your_auth_token"
TWILIO_FROM      = "whatsapp:+14155238886"
""", language="toml")
        return

    st.divider()

    # ── Controls ────────────────────────────────────────────────────────────
    col_a, col_b, col_c = st.columns([1, 1, 2])
    with col_a:
        days_filter = st.selectbox("Εμφάνιση ανανεώσεων", [7, 14, 30, 60, 90],
                                   index=2, format_func=lambda x: f"Επόμενες {x} μέρες")
    with col_b:
        agent_default = st.selectbox("Default Agent", ["3p", "ca", "bu"],
                                     format_func=lambda x: {"3p": "3P Insurance", "ca": "CA Insurance", "bu": "Brokers Union"}[x])
    with col_c:
        refresh = st.button("🔄 Ανανέωση από Portal", type="primary")

    # ── Fetch data ────────────────────────────────────────────────────────
    cache_key = f"renewals_data_{days_filter}"
    if refresh or cache_key not in st.session_state:
        with st.spinner("Φόρτωση από CHI Portal…"):
            data, err = _api_get("/api/renewals")
            if err:
                # fallback: try /api/policies/expiring
                data2, err2 = _api_get("/api/policies/expiring", {"days": days_filter})
                if err2:
                    st.error(f"Portal error: {err}")
                    return
                # wrap flat list into renewals format
                all_p = data2 if isinstance(data2, list) else []
                urgent   = [p for p in all_p if p.get("days_left", 99) <= 7]
                soon     = [p for p in all_p if 7 < p.get("days_left", 99) <= 30]
                upcoming = [p for p in all_p if p.get("days_left", 99) > 30]
                data = {"urgent": urgent, "soon": soon, "upcoming": upcoming}
            st.session_state[cache_key] = data

    data = st.session_state.get(cache_key, {})

    urgent   = data.get("urgent",   [])
    soon     = data.get("soon",     [])
    upcoming = data.get("upcoming", [])

    # Filter by days_filter
    def within(items, max_days):
        return [p for p in items if p.get("days_left", 999) <= max_days]

    all_renewals = within(urgent + soon + upcoming, days_filter)

    # ── Summary KPIs ────────────────────────────────────────────────────────
    k1, k2, k3, k4 = st.columns(4)
    k1.metric("Σύνολο",        len(all_renewals))
    k2.metric("🔴 Επείγοντα ≤7d",  len([p for p in all_renewals if p.get("days_left",99) <= 7]))
    k3.metric("🟠 Σύντομα ≤14d",   len([p for p in all_renewals if 7 < p.get("days_left",99) <= 14]))
    k4.metric("🟡 Επόμενο μήνα",   len([p for p in all_renewals if 14 < p.get("days_left",99) <= 30]))

    st.divider()

    if not all_renewals:
        st.info(f"Δεν υπάρχουν ανανεώσεις για τις επόμενες {days_filter} μέρες.")
        return

    # ── Per-policy action table ─────────────────────────────────────────────
    # Track sent status in session
    if "renewal_sent" not in st.session_state:
        st.session_state.renewal_sent = {}  # policy_id → {"email": bool, "wa": bool}

    # Group header
    sections = [
        ("🔴 Επείγοντα — Λήγουν σε ≤ 7 μέρες",  [p for p in all_renewals if p.get("days_left",99) <= 7],   "#fef2f2"),
        ("🟠 Σύντομα — Λήγουν σε 8–14 μέρες",   [p for p in all_renewals if 7 < p.get("days_left",99) <= 14], "#fff7ed"),
        ("🟡 Επόμενος μήνας — 15–30 μέρες",      [p for p in all_renewals if 14 < p.get("days_left",99) <= 30], "#fefce8"),
        ("🟢 Αργότερα — > 30 μέρες",              [p for p in all_renewals if p.get("days_left",99) > 30],    "#f0fdf4"),
    ]

    for section_title, policies, bg_color in sections:
        if not policies:
            continue

        st.markdown(f"### {section_title}")

        for idx, policy in enumerate(policies):
