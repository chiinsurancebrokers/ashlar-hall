                            else:
                                st.error(err_msg)
                    st.components.v1.html(body, height=500, scrolling=True)

    st.divider()

    # ── Bulk Send ──────────────────────────────────────────────────────────
    st.markdown("### 📦 Μαζική Αποστολή")
    bc1, bc2, bc3 = st.columns(3)

