        st.error("Ορίστε **PORTAL_API_URL** και **PORTAL_API_KEY** στα Streamlit secrets πρώτα.")
        with st.expander("Πώς να ρυθμίσετε"):
            st.code("""# Streamlit Cloud → Settings → Secrets
